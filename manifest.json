{
  "manifest_version": 3,
  "name": "Authnudge",
  "version": "0.1.0",
  "description": "Ask an Authnudge account holder to sign you in. The extension never shows the credentials.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Authnudge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
