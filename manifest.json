{
  "manifest_version": 3,
  "name": "Authnudge",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "description": "Ask an Authnudge account holder to sign you in. The extension never shows the credentials.",
  "homepage_url": "https://authnudge.com",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Authnudge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": [
    "https://authnudge.com/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
